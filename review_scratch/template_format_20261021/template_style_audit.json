  "heading_like_paragraphs_not_heading_style": [
    {
      "para_index": 10,
      "text": "\u5173\u952e\u8bcd\uff1a\u591a\u76f8\u6d41\uff1b\u6405\u62cc\u5668\uff1b\u6d41\u573a\u6a21\u62df\uff1b\u8f6f\u4ef6\u5f00\u53d1\uff1bFLUENT\uff1bANSYS\uff08\u4e94\u53f7\u5b8b\u4f53\uff09",
      "style": "Normal"
    },
    {
      "para_index": 12,
      "text": "doi: \uff08\u4e94\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09\uff08\u6b64\u5904\u7531\u7f16\u8f91\u90e8\u7f16\u5199\uff09",
      "style": "Normal"
    },
    {
      "para_index": 14,
      "text": "0 \u5f15\u8a00\uff08\u4e00\u7ea7\u6807\u9898\uff1a\u5c0f\u56db\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff0c\u5982\u6709\u5f15\u8a00\u5e8f\u53f7\u4e3a0\uff0c\u5982\u6ca1\u6709\uff0c\u53ef\u4ee5\u4e0d\u5199\uff09",
      "style": "Normal"
    },
    {
      "para_index": 17,
      "text": "1 \u6b63\u6587\u683c\u5f0f\uff08\u4e00\u7ea7\u6807\u9898\uff1a\u5c0f\u56db\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 24,
      "text": "2 \u89c4\u8303\u8868\u8fbe\uff08\u4e00\u7ea7\u6807\u9898\uff1a\u5c0f\u56db\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 25,
      "text": "2.1  \u8bba\u6587\u5206\u680f\uff08\u4e94\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 27,
      "text": "2.2 \u540d\u8bcd\u672f\u8bed\uff08\u4e94\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 29,
      "text": "2.3  \u6570\u5b57\uff08\u4e94\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 35,
      "text": "2.4  \u5916\u6587\u5b57\u6bcd\uff08\u4e94\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 53,
      "text": "2.5  \u6570\u5b66\u516c\u5f0f\uff08\u4e94\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 59,
      "text": "2.6  \u63d2\u56fe\uff08\u4e94\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 70,
      "text": "2.7  \u8868\u683c\uff08\u4e94\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 74,
      "text": "\u88681\u00a0\u4e0d\u540c\u5408\u6210\u65b9\u6cd5\u6da6\u6ed1\u8102\u7684\u7406\u5316\u6307\u6807\u53ca\u566a\u58f0\u503c\uff08\u5c0f\u4e94\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 75,
      "text": "2.8  \u53c2\u8003\u6587\u732e\u683c\u5f0f\uff08\u4e94\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 78,
      "text": "\u88682 \u6587\u732e\u7c7b\u578b\u548c\u6807\u5fd7\u4ee3\u7801\uff08\u5c0f\u4e94\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 80,
      "text": "3  \u7ed3\u8bed\uff08\u5c0f\u56db\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09",
      "style": "Normal"
    },
    {
      "para_index": 84,
      "text": "\u53c2\u8003\u6587\u732e\uff1a\uff08\u4e94\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff09\u3000",
      "style": "Normal"
    },
    {
      "para_index": 94,
      "text": "Charged active contour model\uff08\u56db\u53f7Times New Roman\u4f53,\u52a0\u7c97\uff0c\u9664\u5730\u540d\u3001\u4e13\u6709\u540d\u8bcd\u5916\uff0c\u7b2c\u4e00\u4e2a\u8bcd\u7684\u7b2c\u4e00\u4e2a\u5b57\u6bcd\u5927\u5199\uff0c\u5176\u4f59\u5747\u5c0f\u5199\uff09",
